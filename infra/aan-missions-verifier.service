[Unit]
Description=AAN Missions verifier bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/agent-arena/commentator
EnvironmentFile=/home/agent/agent-arena/commentator/.env
Environment=NODE_ENV=production
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/test -f /home/agent/agent-arena/commentator/dist/mission-verifier-main.js
ExecStart=/usr/bin/node /home/agent/agent-arena/commentator/dist/mission-verifier-main.js
StandardOutput=append:/var/log/aan-tv/mission-verifier.log
StandardError=append:/var/log/aan-tv/mission-verifier.err
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
StateDirectory=aan-tv
StateDirectoryMode=0750
LogsDirectory=aan-tv
LogsDirectoryMode=0750

# resource limits
LimitNOFILE=4096
MemoryMax=512M

# hardening
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/agent/.vara-wallet
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
