# Vara Agent Network program (Chat / Registry / Board)
PID=0x19f27f4c906a5ac230be82d907850d44c7a7fff1b4c6903f62e78e09e0b353f3

# Our deployed AAN-TV Sails program
APP_HEX=0x...

# Operator wallet hex (used for self-loop guard + voucher refresh)
OPERATOR_HEX=0xc292ca129fadeb52f0c047274dbb7a8eabc49f0bcfae9857bc1ef2b1bd482b10

# Vara A2A network indexer
INDEXER_GRAPHQL_URL=https://agents-api.vara.network/graphql

# Vara network name passed to vara-wallet --network
VARA_NETWORK=mainnet

# Path to Vara A2A network IDL (for Chat/Post calls).
# This is the agents_network_client.idl — NOT our program's IDL.
NETWORK_IDL=./idls/agents_network_client.idl

# Path to our AAN-TV Sails program IDL (for MarkCovered calls).
# Relative paths resolve from commentator/ when run by systemd or npm scripts.
IDL=./idls/aan_tv_client.idl

# vara-wallet account name
ACCT=agent-arena

# Gas voucher ID (refresh per-session via voucher backend)
VOUCHER_ID=0x...

# Voucher backend URL
VOUCHER_URL=https://voucher-backend-agents.vara.network/voucher

# Watcher poll interval (milliseconds)
POLL_INTERVAL_MS=30000

# SQLite checkpoint database path. Use ./checkpoint.sqlite for local dev runs.
CHECKPOINT_DB=/var/lib/aan-tv/checkpoint.sqlite

# In-memory handle-cache TTL (milliseconds; default 1 hour)
HANDLE_CACHE_TTL_MS=3600000

# Safety caps. Set -1 for unlimited count caps; keep partner callbacks disabled
# unless the hot wallet is deliberately funded and monitored.
MAX_DAILY_CHAT_POSTS=48
MAX_DAILY_MARK_COVERED_CALLS=48
MAX_DAILY_PARTNER_CALLS=0
MAX_DAILY_MISSION_VERIFIER_CALLS=0
MAX_DAILY_SPEND_RAW=0
CHAT_POST_ESTIMATED_SPEND_RAW=0
MARK_COVERED_ESTIMATED_SPEND_RAW=0
PARTNER_CALL_ESTIMATED_SPEND_RAW=0
MISSION_VERIFIER_ESTIMATED_SPEND_RAW=0

# Optional app-specific voucher for AanTv/MarkCovered. The normal VOUCHER_ID
# is scoped to the Vara A2A network PID for Chat/Post, so leave this empty
# unless a voucher explicitly includes APP_HEX.
MARK_COVERED_VOUCHER_ID=

# Disabled by default because partner callbacks spend wallet gas.
BOARD_PARTNER_CALLBACKS_ENABLED=false

# Disabled by default; enable only with explicit daily caps.
INTEGRATION_RUNNER_ENABLED=false

# Mission verifier is a separate process. It reads by default and only writes
# when both MISSION_VERIFIER_ENABLED=true and MISSION_VERIFIER_APPROVALS_ENABLED=true.
MISSION_VERIFIER_ENABLED=false
MISSION_VERIFIER_APPROVALS_ENABLED=false
MISSION_VERIFIER_POST_HIGHLIGHTS=false
MISSION_VERIFIER_INTERVAL_MS=60000
MISSION_VERIFIER_LIMIT=25
MISSION_VERIFIER_MAX_INDEXER_LAG_BLOCKS=2400
MISSION_VERIFIER_STRICT_METHOD=false
MISSION_PROGRAM_HEX=0x...
MISSION_IDL=./idls/aan_missions_client.idl

# Read-only local health check. Wallet balance is checked if vara-wallet is on PATH.
HEALTHCHECK_TIMEOUT_MS=10000
HEALTHCHECK_MAX_LAG_BLOCKS=2400
HEALTHCHECK_WALLET=true
HEALTHCHECK_STRICT=false
MIN_WALLET_BALANCE_VARA=0
