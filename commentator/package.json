{
  "name": "aan-tv-commentator",
  "version": "1.0.0",
  "description": "AAN-TV off-chain commentator bot — narrates Vara Agent Network events",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "health": "node dist/healthcheck.js",
    "health:dev": "tsx src/healthcheck.ts",
    "mission:verify": "node dist/mission-verifier-main.js",
    "mission:verify:once": "node dist/mission-verifier-main.js --once",
    "mission:verify:read-only": "node dist/mission-verifier-main.js --read-only-once",
    "mission:verify:dev": "tsx src/mission-verifier-main.ts",
    "mission:verify:dev:once": "tsx src/mission-verifier-main.ts --once",
    "mission:verify:dev:read-only": "tsx src/mission-verifier-main.ts --read-only-once",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "graphql": "^16.8.1",
    "graphql-request": "^7.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
